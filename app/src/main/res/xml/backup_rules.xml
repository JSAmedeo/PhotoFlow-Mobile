<?xml version="1.0" encoding="utf-8"?>
<!--
  Backup exclusion rules for API ≤ 30 (full-backup-content).
  Mirrored in data_extraction_rules.xml for API 31+.

  Excluding the entire Room database is intentional: a restored backup would contain stale
  upload state (UPLOADING rows, missing local files) that is worse than a clean start.
  The DataStore file holds cloud config and other settings.

  photoflow_credentials.xml is the EncryptedSharedPreferences store (FTP passwords, cloud API
  key). It MUST be excluded explicitly — Android does NOT exclude shared_prefs automatically;
  an app's private shared_prefs directory is exactly what auto-backup captures. The AES master
  key lives in the hardware Keystore and is not backed up, so a restored copy is ciphertext
  with no key: at best useless, at worst it makes EncryptedSharedPreferences.create() throw on
  first launch. CredentialStore recovers from that, but not shipping the broken state is better.
-->
<full-backup-content>
    <exclude domain="database" path="photoflow.db" />
    <exclude domain="database" path="photoflow.db-wal" />
    <exclude domain="database" path="photoflow.db-shm" />
    <exclude domain="file" path="datastore" />
    <exclude domain="sharedpref" path="photoflow_credentials.xml" />
</full-backup-content>
