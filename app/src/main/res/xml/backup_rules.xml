<?xml version="1.0" encoding="utf-8"?>
<!--
  Backup exclusion rules for API ≤ 30 (full-backup-content).
  Mirrored in data_extraction_rules.xml for API 31+.

  Excluding the entire Room database is intentional: a restored backup would contain stale
  upload state (UPLOADING rows, missing local files) that is worse than a clean start.
  The DataStore file holds the Cloud API key and other sensitive config.
  The EncryptedSharedPreferences file (photoflow_credentials) is excluded by Android
  automatically since it lives in the app's private shared_prefs directory.
-->
<full-backup-content>
    <exclude domain="database" path="photoflow.db" />
    <exclude domain="database" path="photoflow.db-wal" />
    <exclude domain="database" path="photoflow.db-shm" />
    <exclude domain="file" path="datastore" />
</full-backup-content>
