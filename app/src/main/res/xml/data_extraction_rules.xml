<?xml version="1.0" encoding="utf-8"?>
<!--
  Data extraction rules for API 31+ (cloud-backup and device-transfer).
  Mirrors the exclusions in backup_rules.xml which covers API ≤ 30.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="photoflow.db" />
        <exclude domain="database" path="photoflow.db-wal" />
        <exclude domain="database" path="photoflow.db-shm" />
        <exclude domain="file" path="datastore" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="photoflow.db" />
        <exclude domain="database" path="photoflow.db-wal" />
        <exclude domain="database" path="photoflow.db-shm" />
        <exclude domain="file" path="datastore" />
    </device-transfer>
</data-extraction-rules>
